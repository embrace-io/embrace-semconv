# Shared external version pins, read by the Makefile and CI. Each `# renovate:` comment lets
# Renovate bump the pin below it, when the repo's Renovate config has a match string for it;
# without Renovate they do nothing.
# A registry's own release version is NOT pinned here: it is the last segment of the schema_url in
# the registry's manifest.yaml, and the registries it depends on are pinned in that manifest too.

# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.26.1

# ==== registry
# The shared OpenTelemetry policy pack that `make validate-registry` runs, pinned to a commit of
# its main branch.
# renovate: datasource=git-refs depName=open-telemetry/opentelemetry-weaver-packages versioning=git ref=main
POLICY_REPO_URL=https://github.com/open-telemetry/opentelemetry-weaver-packages.git
POLICY_REPO_REF=38e6b08183f79904e8f92329a718e9197fcc7b62
# ==== attributes

# Open Policy Agent, used only to unit-test the rego policies under policies/.
# renovate: datasource=github-releases depName=open-policy-agent/opa versioning=semver-coerced
OPA_VERSION=v1.20.2
# ==== end attributes
# ==== end registry

# ==== renovate
# Renovate, for checking the Renovate config locally and in a workflow of the repo's own: the
# version the repo's Renovate runs (for the hosted app, the one its latest pull request names),
# else the newest release that installs. Renovate bumps it like the other pins.
# renovate: datasource=npm depName=renovate versioning=semver
RENOVATE_VERSION=44.131.0
# ==== end renovate
