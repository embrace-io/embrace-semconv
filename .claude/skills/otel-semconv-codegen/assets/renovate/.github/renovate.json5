// Renovate bumps the tool pins in versions.env, the source registry release in the Makefile's
// SOURCE_REGISTRY, the core registry dependency in manifest.yaml files, and the pinned GitHub
// Actions. Each bump arrives as a pull request whose CI shows whether it changes what passes.
// Needs the Renovate GitHub app.
//
// Renovate reads ONE config file. If the repo already has one (renovate.json, renovate.json5,
// .renovaterc*, .github/renovate.json*), merge the customManagers and packageRules below into it,
// keep its own extends, schedule and labels, and don't add this file. If the repo already bumps
// the core registry another way (a scheduled workflow, or by hand), leave out the two
// manifest.yaml match strings, the manifest.yaml file pattern and the "core registry" rule, and
// give a SOURCE_REGISTRY that is the core registry no `# renovate:` line. `managerFilePatterns`
// needs a recent Renovate. A repo's own config validator that reports "disallowed fields:
// managerFilePatterns" runs an old one: an unversioned `renovate` on a Node newer than the latest
// Renovate supports gets an old release, so make it use the version the repo's Renovate runs,
// falling back to versions.env's RENOVATE_VERSION. Only a validator pinned to an old Renovate on
// purpose needs `fileMatch`, the same patterns without the slashes.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  // Once a week, Mondays before 08:00 UTC
  "schedule": ["* 0-7 * * 1"],
  // The pins carry `# renovate:` comments naming their datasource; keep one match string here for
  // each kind of annotated pin. The patterns match at any depth, for projects in a subdirectory.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)versions\\.env$/",
        "/(^|/)manifest\\.yaml$/",
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        // versions.env: WEAVER_VERSION=vX.Y.Z
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+WEAVER_VERSION=(?<currentValue>\\S+)",
        // versions.env: RENOVATE_VERSION=X.Y.Z
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+RENOVATE_VERSION=(?<currentValue>\\S+)",
        // manifest.yaml: the core registry dependency's schema_url version...
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: https://opentelemetry\\.io/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        // ...and its registry_path tag, which must name the same release.
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: \\S+\\s+registry_path:.*?@(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\[model\\]",
        // Makefile: SOURCE_REGISTRY pinned to a release tag
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+SOURCE_REGISTRY := \\S+@(?<currentValue>v[^\\[\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      // The core registry's schema_url and registry_path name the same release, in every
      // manifest that annotates them, so they move in one pull request; weaver doesn't fail when
      // the two disagree. A bump can change the golden files and the generated code: its pull
      // request then needs `make update-golden generate-all`.
      "description": "Bump the core registry dependency everywhere at once",
      "matchDepNames": ["open-telemetry/semantic-conventions"],
      "groupName": "core registry"
    },
    {
      "description": "Group GitHub Actions pin bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      // The CLI pin in versions.env and the setup-weaver action's commit name the same weaver
      // release, so they move in one pull request. Where a GitHub Actions group is kept, this rule
      // comes after it, so that the action joins this group instead.
      "description": "Bump the weaver CLI and its setup action together",
      "matchDepNames": ["open-telemetry/weaver"],
      "groupName": "weaver"
    }
  ],
  "labels": ["dependencies"]
}
