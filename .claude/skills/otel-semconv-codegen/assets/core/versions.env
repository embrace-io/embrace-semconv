# Shared external version pins, read by the Makefile and CI. Each `# renovate:` comment lets
# Renovate bump the pin below it, when the repo's Renovate config has a match string for it;
# without Renovate they do nothing. The source registry is pinned in the Makefile's
# SOURCE_REGISTRY.

# Also pinned, as a commit of the same release, by the setup-weaver action in the workflows.
# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.28.0
# ==== renovate

# Renovate, for checking the Renovate config locally and in a workflow of the repo's own: the
# version the repo's Renovate runs (for the hosted app, the one its latest pull request names),
# else the newest release that installs. Renovate bumps it like the other pins.
# renovate: datasource=npm depName=renovate versioning=semver
RENOVATE_VERSION=44.131.0
# ==== end renovate
