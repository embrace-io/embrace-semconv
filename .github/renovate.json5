// Renovate bumps the tool and policy pins in versions.env, the core registry dependency in the
// manifests, and the pinned GitHub Actions. Each bump arrives as a pull request whose CI shows
// whether it changes what passes.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  // Once a week, Mondays before 08:00 UTC
  "schedule": ["* 0-7 * * 1"],
  "labels": ["dependencies"],
  // The pins carry `# renovate:` comments naming their datasource; there is one match string here
  // for each kind of annotated pin.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.env$/",
        "/(^|/)manifest\\.yaml$/"
      ],
      "matchStrings": [
        // versions.env: WEAVER_VERSION=vX.Y.Z
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+WEAVER_VERSION=(?<currentValue>\\S+)",
        // versions.env: OPA_VERSION=vX.Y.Z
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+OPA_VERSION=(?<currentValue>\\S+)",
        // versions.env: the shared policy pack's URL and commit. git-refs follows the branch named
        // by `ref=` (currentValue) and bumps the commit (currentDigest).
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+ref=(?<currentValue>\\S+)\\s+POLICY_REPO_URL=(?<packageName>\\S+)\\s+POLICY_REPO_REF=(?<currentDigest>\\S+)",
        // manifest.yaml: the core registry dependency's schema_url version...
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: https://opentelemetry\\.io/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        // ...and its registry_path tag, which must name the same release.
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- schema_url: \\S+\\s+registry_path:.*?@(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\[model\\]"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions pin bumps",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      // The CLI pin in versions.env and the setup-weaver action's commit name the same weaver
      // release, so they move in one pull request. This rule comes after the GitHub Actions group
      // so that the action joins this group instead.
      "description": "Bump the weaver CLI and its setup action together",
      "matchDepNames": ["open-telemetry/weaver"],
      "groupName": "weaver"
    },
    {
      // The core registry's schema_url and registry_path name the same release, in the registry's
      // manifest and the fixture's alike, so they move in one pull request. Weaver doesn't fail
      // when the two disagree; `make validate-dependencies` does.
      // Once this registry depends on one that itself depends on the core registry, the core
      // registry's version must match that dependency's (AGENTS.md, "Dependencies").
      "description": "Bump the core registry dependency everywhere at once",
      "matchDepNames": ["open-telemetry/semantic-conventions"],
      "groupName": "core registry"
    }
  ]
}
